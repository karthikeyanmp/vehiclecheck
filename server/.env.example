# Copy to .env and fill in real values. Never commit the real .env.

# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vehicle_permit

# Set to "true" for hosted Postgres (Render, Supabase, etc.) that requires SSL.
# Leave unset / "false" for a local Postgres.
DATABASE_SSL=false

# Secret used to sign login sessions (JWT). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_JWT_SECRET=replace-with-a-long-random-value

# Separate secret used only to sign QR tokens. Keep this different from
# AUTH_JWT_SECRET so a leaked QR token can never be replayed as a login session.
QR_JWT_SECRET=replace-with-a-different-long-random-value

# QR tokens (and therefore printed certificates) stop being accepted after this
# ISO date — set it a day or two past the event to allow late exits.
EVENT_QR_EXPIRY=2026-09-13T00:00:00+05:30

PORT=4000

# Comma-separated list of allowed origins for a SEPARATELY-hosted frontend.
# Leave unset when the server also serves the built client (bundled deploy) —
# that's same-origin and needs no CORS config.
CORS_ORIGIN=http://localhost:5173

# First-boot only: if no admin exists yet, create one from these (used on
# hosts with no shell access, e.g. Render free tier). Safe to leave set;
# it does nothing once an admin exists.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=a-real-strong-password

# Override where the server looks for the built client. Defaults to
# ../client/dist (correct for the bundled deploy). Unset for local dev.
# CLIENT_DIST_PATH=../client/dist
