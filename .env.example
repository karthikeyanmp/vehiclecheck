# Copy to .env for docker-compose.prod.yml. Never commit the real .env.

# The domain this will be served on — must have an A record pointing at this
# server's public IP before you start (Caddy needs it for the TLS cert).
DOMAIN=permits.example.com

# Postgres password (used for the containerised DB).
DB_PASSWORD=change-me-to-a-strong-password

# Session + QR signing secrets. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Keep them different from each other.
AUTH_JWT_SECRET=replace-with-a-long-random-value
QR_JWT_SECRET=replace-with-a-different-long-random-value

# QR tokens / printed certificates stop verifying after this ISO datetime.
EVENT_QR_EXPIRY=2026-09-13T00:00:00+05:30

# Created on first boot if no admin exists yet. Safe to leave set.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-min-10-chars
